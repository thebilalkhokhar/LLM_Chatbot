# ============================================
# Frontend env template.
#
# Copy to .env.local and adjust if your Node
# gateway runs somewhere else.
# ============================================

# Base URL for the Node.js gateway API (no trailing slash).
# Local: http://localhost:4000/api
# Production is set on Vercel as https://llm-backend.vercel.app/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
